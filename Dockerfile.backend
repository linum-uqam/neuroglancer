# Use the official Python image
FROM python:3.10

# Set working directory inside the container
WORKDIR /sbh-neuroglancer

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Create a virtual environment (but do NOT modify PATH globally)
RUN python -m venv .venv

# Copy dependencies first (for caching)
COPY sbh-neuroglancer/requirements.txt requirements.txt

# Install Python dependencies inside the virtual environment
RUN .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt

# Copy all project files
COPY sbh-neuroglancer sbh-neuroglancer

# Install Neuroglancer in editable mode inside the virtual environment
RUN .venv/bin/pip install -e sbh-neuroglancer

# Set Flask app and enable debug mode
ENV FLASK_APP=run_neuroglancer.py
ENV FLASK_DEBUG=1

# Expose Neuroglancer & Flask API ports
EXPOSE 5002 5003

# Run the backend server explicitly using the virtual environment
# CMD [".venv/bin/python", "python/run_neuroglancer.py"]
# CMD [".venv/bin/flask", "--app", "python/run_neuroglancer.py", "--debug", "run", "--host", "0.0.0.0", "--port", "5003"]
CMD [".venv/bin/watchmedo", "auto-restart", "--patterns=*.py", "--ignore-patterns=__pycache__/*;*.pyc", "--recursive", "--interval=1", "--", ".venv/bin/python", "python/run_neuroglancer.py"]
