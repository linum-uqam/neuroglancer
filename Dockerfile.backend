# Use the official Python image
FROM python:3.10

# 1) Create a venv at /venv and put it on PATH
ENV VIRTUAL_ENV=/venv
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 2) Set working dir for your code
WORKDIR /sbh-neuroglancer

# 3) Install OS-level dependencies
RUN apt-get update \
    && apt-get install -y curl nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# 4) Copy only requirements first (for Docker cache)
COPY sbh-neuroglancer/requirements.txt ./requirements.txt

# 5) Install Python deps into the venv
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# 6) Copy your entire Neuroglancer/API code
COPY sbh-neuroglancer/ .

# 7) Install Neuroglancer (and your API) in editable mode
RUN pip install -e .

# 8) Tell Flask where your app is and enable dev mode
ENV FLASK_APP=run_neuroglancer.py
ENV FLASK_ENV=development
ENV FLASK_DEBUG=1

# 9) Expose both Neuroglancer & your API ports
EXPOSE 5002 5003

# 10) Launch Flask with auto-reload and the debugger
CMD ["flask", "run", "--host=0.0.0.0", "--port=5003", "--debug"]
